@model List<ProductDto>

<div class="card shadow border-2 mt-4">
	<div class="card-header bg-secondary bg-gradient ml-0 py-3">
		<div class="row">
			<div class="col-12 text-center">
				<h1 class="text-dark">Products List</h1>
			</div>
		</div>
	</div>
	<div class="card-body p-4">
		<div class="row pb-3">
			<div class="col-6">
			</div>
			<div class="col-6 text-end">
				<a class="btn btn-outline-primary" asp-action="CreateProduct"><i class="bi bi-plus-square"></i> Create New Product</a>
				@* asp-action generates a standard HTML anchor link with an href attribute. Clicking this link always results in an HTTP GET request to the specified action method. *@
				@* when asp-action is used within a form tag, it generates the form's action URL attribute. The HTTP method used for submission is determined by the form's 'method' attribute, which defaults to GET in standard HTML if not specified, but should be explicitly set to POST for form submissions that alter server state. *@
			</div>
		</div>
		<table class="table">
			<thead>
				<tr>
					<th style="width:10rem;">Image</th>
					<th style="width:10rem;">Name</th>
					<th style="width:10rem;">Category Name</th>
					<th style="width:10rem;">Price</th>
					<th style="width:40rem;">Description</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>

						<td>
							<img src="@item.ImageUrl" style="width:80px;height:80px;object-fit:cover;border-radius:6px;" />
						</td>

						<td>
							@item.ProductName
						</td>

						<td>
							@item.CategoryName
						</td>

						<td>
							@item.Price.ToString("C2")
						</td>

						<td>
							@Html.Raw(item.Description)
						</td>

						<td>
							<a class="btn btn-success my-1" asp-action="EditProduct" asp-route-productId="@item.ProductId">
								<i class="bi bi-pencil-square"></i>
							</a>

							<a class="btn btn-danger my-1" asp-action="DeleteProduct" asp-route-productId="@item.ProductId">
								<i class="bi bi-trash"></i>
							</a>
						</td>

					</tr>
				}
			</tbody>
		</table>

	</div>

</div>