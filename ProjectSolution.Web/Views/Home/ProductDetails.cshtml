@model ProductDto
@{
    ViewData["Title"] = "Product Details";
}
<form method="post">
	<input type="hidden" asp-for="ProductId" />  @* type="hidden" is better than using a hidden input tag *@
    <div class="pt-4">
        <div class="card shadow-lg border-2">
            @* never use .row with card-header, body or footer *@
            <div class="card-header bg-light text-dark">
                <div class="row">
                <div class="col-12 col-md-6">
                    <h2 class="fw-bold mb-0">@Model.ProductName</h2>
                    <small class="text-muted">Best price guaranteed</small>

                    @* where Model. is not required?
                        You don’t need @Model. inside tag helpers. For example, in an asp-for attribute, you can just write asp-for="Quantity" instead of asp-for="Quantity".
                    *@

                </div>
                <div class="col-12 col-md-6 text-end">
                    <h2 class="fw-bold" style="color: green">
                        @Model.Price.ToString("C2")
                    </h2>
                </div>
                </div>
            </div>
            <div class="card-body">
                <div class="container rounded bg-dark-subtle p-4">
                    <div class="row">
                        <div class="col-12 col-lg-4 p-1 text-center">
                            <img src="@Model.ImageUrl"
                                 class="img-fluid rounded shadow-sm"
                                 alt="@Model.ProductName" />

                        </div>
                        <div class="col-12 col-lg-8">
                            <div class="row pl-3">
                                <div class="col-12">
                                    <span class="badge rounded-pill bg-warning text-dark px-3 py-2 mb-3">
                                        @Model.CategoryName
                                    </span>

                                    <p class="text-dark lh-lg mt-3">
                                        @Html.Raw(Model.Description)
                                    </p>

                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-4">
                                    <label class="form-label fw-semibold">Quantity</label>
                                    <input class="form-control text-center"
                                           asp-for="Quantity"
                                           type="number" />
                                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-light">
                <div class="row">
                <div class="col-12 col-md-6 pb-1 ">
                        <a class="btn btn-primary btn-square form-control btn-lg fw-bold" style="height:50px;" asp-action="Index">Back to List</a>
                </div>
                <div class="col-12 col-md-6 ">
                        <button type="submit" class="btn btn-success form-control btn-lg fw-bold" style="height:50px;">Add to Cart</button>
                </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}