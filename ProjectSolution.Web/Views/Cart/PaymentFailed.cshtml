@model int

@{
    ViewData["Title"] = "Payment Failed";
}

<div class="container my-5">

    <div class="card shadow-lg border-0 text-center p-5">

        <!-- ICON -->
        <div class="mb-4">
            <i class="bi bi-x-circle-fill text-danger"
               style="font-size: 60px;"></i>
        </div>

        <!-- TITLE -->
        <h2 class="fw-bold text-danger mb-3">
            Payment Failed
        </h2>

        <!-- MESSAGE -->
        <p class="lead text-muted">
            Unfortunately, your payment could not be completed.
        </p>

        <!-- ORDER INFO -->
        <div class="bg-light rounded p-2 my-4">

            <div style="font-size: 1.5rem">
                <strong>Order ID:</strong>
                #@Model
            </div>

        </div>

        <!-- REFUND MESSAGE -->
        <div class="alert alert-warning text-start">

            <strong>Refund Information:</strong><br />

            If any amount was deducted from your account,
            it will be automatically refunded within
            <strong>2–3 business days</strong>.

            <br /><br />

            If you do not see the refund after this period,
            please contact our support team.

        </div>

        <!-- ACTION BUTTONS -->
        <div class="d-flex justify-content-center gap-3 mt-4">

            <a asp-action="Checkout"
               class="btn btn-primary px-4 fw-bold">
                <i class="bi bi-arrow-repeat"></i>
                Try Again
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-secondary px-4 fw-bold">
                <i class="bi bi-arrow-left"></i>
                Continue Shopping
            </a>

        </div>

    </div>

</div>